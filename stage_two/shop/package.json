{
  "name": "northstar-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/frontend run dev",
    "build": "npm --prefix apps/frontend run build",
    "start": "npm --prefix apps/frontend run start",
    "lint": "npm --prefix apps/frontend run lint",
    "typecheck": "npm --prefix apps/frontend run typecheck",
    "test": "npm --prefix apps/frontend run test",
    "backend:dev": "npm --prefix apps/backend run dev",
    "backend:start": "npm --prefix apps/backend run start"
  }
}
